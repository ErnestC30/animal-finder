# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key, used by the embedder (gemini-embedding-2) and by any agent on a Gemini model
GEMINI_API_KEY=your-gemini-api-key

# PostgreSQL connection
# Use DB_HOST=host.docker.internal when running the backend inside Docker
DB_HOST=localhost
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=animals

# Agent models: gemini-3.5-flash-lite | gemini-3.1-flash-lite | claude-opus-5-5 | claude-sonnet-5-5
# The API key must belong to the provider of the chosen model (Gemini key or Anthropic key).
CHAT_AGENT_MODEL=gemini-3.5-flash-lite
CHAT_AGENT_API_KEY=your-gemini-or-anthropic-api-key

FEATURE_AGENT_MODEL=gemini-3.1-flash-lite
FEATURE_AGENT_API_KEY=your-gemini-or-anthropic-api-key

RERANK_AGENT_MODEL=gemini-3.1-flash-lite
RERANK_AGENT_API_KEY=your-gemini-or-anthropic-api-key
